{
  "info": {
    "name": "Tools and Tackles API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "token", "value": "YOUR_JWT_TOKEN" }
  ],
  "item": [
    {
      "name": "Create Tools and Tackles",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "formdata",
          "formdata": [
            { "key": "permit_no", "value": "TAT-2026-001", "type": "text" },
            { "key": "date", "value": "2026-01-06", "type": "text" },
            { "key": "type_of_work", "value": "Mechanical Maintenance", "type": "text" },
            { "key": "name_of_supervisor", "value": "Jane Doe", "type": "text" },
            { "key": "sop_number", "value": "SOP-MM-005", "type": "text" },
            { "key": "job_description", "value": "Pump maintenance in boiler room", "type": "text" },
            { "key": "status", "value": "open", "type": "text" },
            { "key": "tools_status", "value": "[{\"tool_name\":\"Torque Wrench\",\"tool_status\":\"Good\"},{\"tool_name\":\"Safety Harness\",\"tool_status\":\"Needs Inspection\"},{\"tool_name\":\"Multimeter\",\"tool_status\":\"Good\"}]", "type": "text" },
            { "key": "before_imgs", "type": "file", "src": [] },
            { "key": "before_imgs", "type": "file", "src": [] },
            { "key": "before_imgs", "type": "file", "src": [] },
            { "key": "after_imgs", "type": "file", "src": [] },
            { "key": "after_imgs", "type": "file", "src": [] },
            { "key": "after_imgs", "type": "file", "src": [] }
          ]
        },
        "url": "{{baseUrl}}/api/tools-and-tackles"
      }
    },
    {
      "name": "Get My Records",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": "{{baseUrl}}/api/tools-and-tackles/my-records"
      }
    },
    {
      "name": "Get All (Admin)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": "{{baseUrl}}/api/tools-and-tackles/all"
      }
    },
    {
      "name": "Get By ID",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": "{{baseUrl}}/api/tools-and-tackles/1"
      }
    },
    {
      "name": "Update Tools and Tackles",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "formdata",
          "formdata": [
            { "key": "permit_no", "value": "TAT-2026-001", "type": "text" },
            { "key": "date", "value": "2026-01-06", "type": "text" },
            { "key": "type_of_work", "value": "Mechanical Maintenance", "type": "text" },
            { "key": "name_of_supervisor", "value": "Jane Doe", "type": "text" },
            { "key": "sop_number", "value": "SOP-MM-005", "type": "text" },
            { "key": "job_description", "value": "Pump maintenance in boiler room", "type": "text" },
            { "key": "status", "value": "close", "type": "text" },
            { "key": "tools_status", "value": "[{\"tool_name\":\"Torque Wrench\",\"tool_status\":\"Good\"},{\"tool_name\":\"Safety Harness\",\"tool_status\":\"Good\"}]", "type": "text" },
            { "key": "before_imgs", "type": "file", "src": [] },
            { "key": "before_imgs", "type": "file", "src": [] },
            { "key": "after_imgs", "type": "file", "src": [] },
            { "key": "after_imgs", "type": "file", "src": [] }
          ]
        },
        "url": "{{baseUrl}}/api/tools-and-tackles/1"
      }
    },
    {
      "name": "Delete",
      "request": {
        "method": "DELETE",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": "{{baseUrl}}/api/tools-and-tackles/1"
      }
    },
    {
      "name": "Login (get token)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"yourpassword\"\n}"
        },
        "url": "{{baseUrl}}/api/auth/login"
      }
    }
  ]
}
